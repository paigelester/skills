    { "id": "review", "script": "reviews", "onFail": "build", "maxLoops": 3 },
    { "id": "squash", "script": "squash", "only": "agent-owned", "onFail": "build", "maxLoops": 2 },
    { "id": "pr", "script": "open-pr", "only": "agent-owned", "maxLoops": 2 },
    { "id": "handoff", "script": "handoff" }
  ]
